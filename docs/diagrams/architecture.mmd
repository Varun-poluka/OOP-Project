---
title: I-ITSM layered architecture
---
flowchart TB
    REACT["<b>React app</b> (Vite, TypeScript)<br/>pages/ + features/: employee, technician, admin screens<br/>api/: fetch with JWT + TanStack Query cache<br/>live/: EventSource for Server-Sent Events<br/>auth/: token storage, role-based routes"]

    SEC["<b>Security</b> (config: SecurityConfig, JwtConfig)<br/>checks the JWT, applies role rules per URL"]
    CTRL["<b>controller</b><br/>IncidentController, AdminController, ReportController,<br/>ServiceController, NotificationController, AuthController,<br/>ReferenceDataController, LiveUpdateController (/api/stream)<br/>GlobalExceptionHandler: exception -> HTTP status + ProblemDetail"]
    DTO["<b>dto</b><br/>request / response records"]
    SVC["<b>service</b><br/>IncidentService, SlaService, ReportService, NotificationService, AuthService, ...<br/>intelligence/: duplicates, priority decorator, service impact, SLA risk, technician scores<br/>notification/: three IncidentEventListeners (Observer)<br/>live/: LiveUpdateRegistry (open SSE connections)"]
    SCH["<b>SlaScheduler</b><br/>every 60 s: SlaService.checkAll"]
    SEED["<b>config: DataSeeder, DemoDataLoader</b><br/>startup data (demo profile)"]
    DOM["<b>domain</b><br/>entities: Incident, User hierarchy, Category, ITService, SLAPolicy, ...<br/>State classes, strategies, events, custom exceptions"]
    REPO["<b>repository</b><br/>Spring Data JPA interfaces + IncidentSpecifications"]
    DB[("<b>PostgreSQL 17</b><br/>itsm (app), itsm_test (tests)")]

    REACT -- "REST JSON over HTTP<br/>Authorization: Bearer JWT" --> SEC
    REACT -- "SSE: text/event-stream" --> SEC
    SEC --> CTRL
    CTRL --> DTO
    CTRL --> SVC
    SCH --> SVC
    SEED --> SVC
    SVC --> DOM
    SVC --> REPO
    REPO --> DOM
    REPO -- "Hibernate / JDBC" --> DB
    SVC -. "events pushed after commit" .-> REACT
