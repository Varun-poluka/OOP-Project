---
title: I-ITSM database (generated by Hibernate from the JPA entities)
---
erDiagram
    users {
        varchar id PK
        varchar role "EMPLOYEE | TECHNICIAN | ADMINISTRATOR (single-table inheritance)"
        varchar name
        varchar email UK
        varchar password_hash "BCrypt"
        int max_workload "technicians only"
        int active_incidents "technicians only"
        boolean available "technicians only"
    }
    category {
        varchar name PK
        varchar description
    }
    technician_skills {
        varchar technician_id PK,FK
        varchar category_name PK,FK
    }
    it_service {
        bigint id PK
        varchar name UK
        int business_criticality
    }
    service_dependencies {
        bigint service_id FK "depends on..."
        bigint depends_on_id FK "...this service"
    }
    slapolicy {
        varchar priority PK "P1..P4"
        int response_minutes
        int resolution_minutes
    }
    incident {
        varchar id PK "INC-0001"
        varchar title
        varchar description
        varchar reporter_id FK
        varchar category_name FK
        bigint affected_service_id FK
        varchar assigned_technician_id FK
        varchar impact
        varchar urgency
        varchar priority
        varchar status
        varchar resolution_details
        timestamp created_at
        timestamp acknowledged_at
        timestamp resolved_at
        timestamp closed_at
        timestamp response_due_at
        timestamp resolution_due_at
        boolean response_breached
        boolean resolution_breached
        boolean response_at_risk
        boolean resolution_at_risk
    }
    audit_record {
        bigint id PK
        varchar incident_id FK
        varchar actor_id FK "null = SYSTEM"
        varchar action
        varchar previous_status
        varchar new_status
        varchar description
        timestamp timestamp
    }
    investigation_note {
        bigint id PK
        varchar incident_id FK
        varchar author_id FK
        varchar text
        timestamp created_at
    }
    notification {
        bigint id PK
        varchar recipient_id FK
        varchar incident_id "plain column, no FK"
        varchar message
        boolean is_read
        timestamp created_at
    }

    users ||--o{ incident : "reports"
    users |o--o{ incident : "is assigned"
    category ||--o{ incident : "classifies"
    it_service ||--o{ incident : "is affected by"
    incident ||--o{ audit_record : "has trail"
    users |o--o{ audit_record : "acts in"
    incident ||--o{ investigation_note : "has"
    users ||--o{ investigation_note : "writes"
    users ||--o{ notification : "receives"
    users ||--o{ technician_skills : "has skill"
    category ||--o{ technician_skills : "is skill of"
    it_service ||--o{ service_dependencies : "depends on"
    it_service ||--o{ service_dependencies : "is needed by"
